# ─────────────────────────────────────────────────────────────
#  Copy this file to  .env  and fill in your own values.
#
#      cp .env.example .env          (macOS / Linux)
#      copy .env.example .env        (Windows cmd)
#      Copy-Item .env.example .env   (PowerShell)
#
#  .env is git-ignored. NEVER commit it.
#  This file (.env.example) is committed on purpose — it tells
#  you WHICH variables to set, and contains no real values.
# ─────────────────────────────────────────────────────────────


# ── HuggingFace ──────────────────────────────────────────────
# Needed to download the local models (Qwen3.5, SmolLM3, Nemotron).
# Get one free at: https://huggingface.co/settings/tokens
# A "Read" token is all you need.
HF_TOKEN="ENTER YOUR HF TOKEN HERE"

# Set both to 1 to force fully offline mode once models are cached.
# Useful on stage: guarantees no network call can hang a demo.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Faster model downloads. huggingface-hub 1.x uses Xet for this; the older
# HF_HUB_ENABLE_HF_TRANSFER variable is deprecated and will warn if you set it.
HF_XET_HIGH_PERFORMANCE=1


# ── Tavily — live web search (Section 6, "The Hoverboard") ────
# Free tier is generous and is plenty for the demos.
# Get one at: https://app.tavily.com
TAVILY_API_KEY="ENTER YOUR TAVILY KEY HERE"


# ── Anthropic — the hosted-API notebook variants (*_api.ipynb) ─
# ONLY needed if you run the "_api" notebooks instead of "_local".
# If you are running everything locally, leave this blank.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Which hosted model the _api notebooks use. Pick by budget:
#   claude-opus-5      $5 / $25 per million tokens (in / out)  - most capable
#   claude-sonnet-5    $3 / $15                                - balanced
#   claude-haiku-4-5   $1 / $5                                 - cheapest
ANTHROPIC_MODEL="claude-haiku-4-5"


# ── Local model selection ────────────────────────────────────
# The default workhorse for the agent demos. See src/delorean/models.py
# for the full registry and a strengths/weaknesses comparison.
#   Qwen/Qwen3.5-4B                        - best tool calling, our default
#   HuggingFaceTB/SmolLM3-3B               - smallest, great "look how tiny" story
#   nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16  - strong sequential reasoning
LOCAL_MODEL="Qwen/Qwen3.5-4B"

# The tiny model used in Section 2 to show token-by-token generation.
# Runs on almost anything, including a laptop with no GPU.
TINY_MODEL="Qwen/Qwen3.5-0.8B"
